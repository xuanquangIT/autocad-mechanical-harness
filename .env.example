# Copy to .env and adjust. Never commit .env.
# Every value here is infrastructure configuration only.
# Engineering values (sizes, datums, tolerances) must never come from env vars.

CAD_HARNESS_CONFIG=./config/base.yaml
CAD_HARNESS_ENVIRONMENT=development

# Adapter: fake | dxf_preview | com | dotnet_bridge
CAD_HARNESS_ADAPTER=fake

# Local-only mode blocks any outbound network call from the harness.
CAD_HARNESS_LOCAL_ONLY=true

# Secret used to sign short-lived approval tokens. Generate per workstation.
CAD_HARNESS_APPROVAL_SECRET=change-me-per-workstation

# Storage
CAD_HARNESS_SQLITE_PATH=./data/harness.db
CAD_HARNESS_PREVIEW_DIR=./data/previews
CAD_HARNESS_CHECKPOINT_DIR=./data/checkpoints

# Logging: DEBUG | INFO | WARNING | ERROR
CAD_HARNESS_LOG_LEVEL=INFO
