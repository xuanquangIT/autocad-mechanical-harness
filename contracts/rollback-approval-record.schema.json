{
  "$id": "https://cad-harness.local/contracts/rollback-approval-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One human authorization for one exact destructive restore scope.\n\nThis record is intentionally independent from :class:`ApprovalRecord`: approval\nto create entities never authorizes discarding later drawing work.",
  "properties": {
    "approval_id": {
      "title": "Approval Id",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "approved_by": {
      "title": "Approved By",
      "type": "string"
    },
    "checkpoint_id": {
      "title": "Checkpoint Id",
      "type": "string"
    },
    "current_revision": {
      "title": "Current Revision",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.13",
      "default": "1.13",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "job_id",
    "document_id",
    "checkpoint_id",
    "current_revision",
    "approved_by",
    "approved_at",
    "expires_at"
  ],
  "title": "RollbackApprovalRecord",
  "type": "object"
}
