{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "description": "One rule outcome, always carrying evidence a human can check.",
      "properties": {
        "actual": {
          "default": null,
          "title": "Actual"
        },
        "entity_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Ref"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "measurement": {
          "additionalProperties": true,
          "title": "Measurement",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "suggested_fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Fix"
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "blocking"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValidationStage": {
      "description": "Pipeline stages from architecture section 7.5.",
      "enum": [
        "schema",
        "semantic_input",
        "plan",
        "preview_geometry",
        "company_standard",
        "pre_commit",
        "post_commit"
      ],
      "title": "ValidationStage",
      "type": "string"
    }
  },
  "$id": "https://cad-harness.local/contracts/validation-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "plan_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Hash"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/ValidationStage"
    },
    "validation_id": {
      "title": "Validation Id",
      "type": "string"
    }
  },
  "required": [
    "validation_id",
    "job_id",
    "stage"
  ],
  "title": "ValidationReport",
  "type": "object"
}
