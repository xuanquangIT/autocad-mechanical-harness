{
  "$defs": {
    "PreviewArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "title": "Artifact Ref",
          "type": "string"
        },
        "byte_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Size"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "artifact_ref"
      ],
      "title": "PreviewArtifact",
      "type": "object"
    }
  },
  "$id": "https://cad-harness.local/contracts/preview-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PreviewArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "company_approved": {
      "default": false,
      "title": "Company Approved",
      "type": "boolean"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "preview_id": {
      "title": "Preview Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.10",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "preview_id",
    "job_id",
    "plan_hash"
  ],
  "title": "PreviewResult",
  "type": "object"
}
