{
  "$defs": {
    "ErrorPayload": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "required_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Action"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorPayload",
      "type": "object"
    },
    "MissingInput": {
      "additionalProperties": false,
      "description": "A required engineering input the caller must supply before compiling.",
      "properties": {
        "accepted_formats": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Accepted Formats",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "MissingInput",
      "type": "object"
    },
    "ToolStatus": {
      "enum": [
        "ok",
        "needs_input",
        "rejected",
        "conflict",
        "failed",
        "partial"
      ],
      "title": "ToolStatus",
      "type": "string"
    }
  },
  "$id": "https://cad-harness.local/contracts/tool-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Uniform envelope returned by every public MCP tool.",
  "properties": {
    "audit_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audit Event Id"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "missing_inputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MissingInput"
      },
      "title": "Missing Inputs",
      "type": "array"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "schema_version": {
      "const": "1.13",
      "default": "1.13",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ToolStatus"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status"
  ],
  "title": "ToolResponse",
  "type": "object"
}
