{
  "$defs": {
    "JobState": {
      "enum": [
        "CREATED",
        "SPEC_ACCEPTED",
        "PLANNED",
        "PREVIEWED",
        "VALIDATED",
        "APPROVED",
        "COMMITTING",
        "COMMITTED",
        "UNKNOWN_COMMIT_STATE",
        "FAILED",
        "ROLLED_BACK",
        "CANCELLED"
      ],
      "title": "JobState",
      "type": "string"
    }
  },
  "$id": "https://cad-harness.local/contracts/cad-job.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Aggregate tracking one change to one document.\n\nImmutable by design: transitions return a new instance so history can be\nreconstructed from the audit log.",
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "checkpoint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "expected_revision": {
      "title": "Expected Revision",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "plan_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Hash"
    },
    "plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Id"
    },
    "schema_version": {
      "default": "1.10",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spec Id"
    },
    "spec_version": {
      "default": 0,
      "title": "Spec Version",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/JobState",
      "default": "CREATED"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "document_id",
    "expected_revision"
  ],
  "title": "CadJob",
  "type": "object"
}
