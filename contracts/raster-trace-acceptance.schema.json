{
  "$id": "https://cad-harness.local/contracts/raster-trace-acceptance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_by": {
      "title": "Accepted By",
      "type": "string"
    },
    "accepted_candidate_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Accepted Candidate Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.13",
      "default": "1.13",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "trace_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Trace Digest",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "trace_id",
    "trace_digest",
    "source_sha256",
    "accepted_candidate_ids",
    "accepted_by"
  ],
  "title": "RasterTraceAcceptance",
  "type": "object"
}
